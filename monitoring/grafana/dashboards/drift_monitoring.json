      "id": 100,
      "title": "Drift Detection Metrics (DriftLens & MCD-DD)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB_Flux"
      },
      "description": "Fréchet Drift Distance (FDD) score calculated per event-time window against baseline reference.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Drift Score (FDD / MCD)",
            "axisPlacement": "auto",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.45
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "driftlens_score"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "DriftLens Score (FDD)"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "super-light-blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mcddd_score"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "MCD-DD Score"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "driftlens_threshold"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Alarm Threshold"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [10, 10],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB_Flux"
          },
          "query": "from(bucket: \"cdd-bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"drift_metrics\")\n  |> filter(fn: (r) => r[\"_field\"] == \"driftlens_score\" or r[\"_field\"] == \"mcddd_score\" or r[\"_field\"] == \"driftlens_threshold\")\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n",
          "refId": "A"
        }
      ],
      "title": "DriftLens Score vs Time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB_Flux"
      },
      "description": "Active binary drift alarm states (0 = Normal, 1 = Alarm).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "NORMAL"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DRIFT ALARM"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
